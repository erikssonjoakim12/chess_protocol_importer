# Copy this file to .env and fill in your key.

# Which reader turns photos into text: gemini (default) or mock (no API, for testing)
READER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini models to use, see https://ai.google.dev/gemini-api/docs/models
# Fast reading: these read every page at the same time and are compared.
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# ...tried one by one if those are busy or out of quota:
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
# "Read carefully" button:
# GEMINI_CAREFUL_MODELS=gemini-3.5-flash,gemini-3.8-flash
# GEMINI_CAREFUL_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite
